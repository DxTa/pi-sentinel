{
  "name": "@dxta/pi-sentinel",
  "version": "0.1.0",
  "description": "Permission enforcement, network domain gating, sandboxed Bash, and masked credential paths for the Pi coding agent.",
  "type": "module",
  "exports": {
    ".": "./src/service.ts"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "files": [
    "src",
    "scripts/calibration-report.mjs",
    "bin/sandbox-run.mjs",
    "bin/sandbox-run-env.mjs",
    "config.json",
    "profiles",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "bin/patch-sandbox-runtime.mjs",
    "patches"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "coding-agent",
    "permissions",
    "policy",
    "access-control",
    "authorization",
    "security",
    "sandbox"
  ],
  "author": {
    "name": "DxTa"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DxTa/pi-sentinel.git"
  },
  "homepage": "https://github.com/DxTa/pi-sentinel#readme",
  "bugs": {
    "url": "https://github.com/DxTa/pi-sentinel/issues"
  },
  "engines": {
    "node": ">=23.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2",
    "@earendil-works/pi-tui": ">=0.75.5"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.75.5",
    "@types/node": "^22.15.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.75",
    "@huggingface/transformers": "^4.3.0",
    "onnxruntime-node": "^1.30.0",
    "tree-sitter-bash": "0.25.1",
    "web-tree-sitter": "0.26.9"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node bin/patch-sandbox-runtime.mjs"
  }
}
