{
  "$schema": "https://raw.githubusercontent.com/DxTa/pi-sentinel/main/schemas/permissions.schema.json",

  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "yoloAutoMode": true,
  "yoloAutoMaxLevel": "l3",
  "yoloAskBashPatterns": [],

  "piInfrastructureReadPaths": [],

  "network": {
    "enabled": true,
    "unknownDomains": "ask",
    "allowedDomains": [],
    "deniedDomains": []
  },

  "sandbox": {
    "enabled": true,
    "backend": "srt",
    "defaultProfile": "online-dev",
    "bypassCommands": ["*"]
  },

  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "read": "allow",
    "write": "deny",
    "edit": "deny",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff": "allow",
      "git *": "ask"
    },
    "mcp": { "*": "ask", "mcp_status": "allow", "mcp_list": "allow" },
    "skill": { "*": "ask" },
    "external_directory": {
      "*": "ask"
    }
  }
}
